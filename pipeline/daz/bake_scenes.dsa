// Daz Studio batch bake: one Genesis 9 scene per job, exported for the app's figure renders.
//
//   DAZStudio.exe -noPrompt -scriptArg <jobs.json> pipeline/daz/bake_scenes.dsa
//   (run by pipeline/daz/bake.py, which writes jobs.json and post-processes the output)
//
// jobs.json: { "library": "<Daz library root>/", "jobs": [ { "out": "<dir>/", "presets": [ "<library-
// relative .duf>", ... ], "morphs": { "<modifier name>": value, ... } } ] }
// Presets are applied in order with Genesis 9 selected (character, skin, age, pose, expression,
// hair); morphs then set modifier values directly (e.g. facs_ctrl_MouthSmile).
//
// Per job, in <out>: scene.obj/.mtl (every visible figure at base resolution, posed, centimetres,
// one OBJ group per node, usemtl per surface), bones.json (world-space joint origins and ends) and
// materials.json (every material's numeric/colour properties and texture maps). Daz Studio does the
// shaping, posing, expression, follower fitting (eyes, mouth, lashes, brows, hair) and correctives;
// the Python side only reads the result.
(function () {
	var args = App.scriptArgs, log = [], logPath = String(args[0]).replace(/\.json$/, ".log");
	function write(path, text) { var f = new DzFile(path); f.open(DzFile.WriteOnly); f.write(text); f.close(); }
	try { run(); } catch (e) { log.push("FATAL " + e + " args=" + args.join("|")); }
	write(logPath, log.join("\n") + "\n");
	App.delayedExit();

	function run() {
	var jobsFile = new DzFile(args[0]);
	jobsFile.open(DzFile.ReadOnly);
	var text = String(jobsFile.read());
	jobsFile.close();
	var spec = JSON.parse(text);
	var lib = spec.library;

	function num(x) { return Math.round(x * 100000) / 100000; }

	function figures() {
		var out = [], nodes = Scene.getNodeList();
		for (var i = 0; i < nodes.length; i++) if (nodes[i].inherits("DzSkeleton")) out.push(nodes[i]);
		return out;
	}

	// A morph or controller by name: a modifier on the mesh (shape morphs) or a property on the
	// figure node (character controllers such as Kat_figure_ctrl_Character).
	function setModifier(fig, name, value) {
		var obj = fig.getObject();
		for (var j = 0; j < obj.getNumModifiers(); j++) {
			var m = obj.getModifier(j);
			if (m.getName() === name) { m.getValueControl().setValue(value); return true; }
		}
		var p = fig.findProperty(name);
		if (p) { p.setValue(value); return true; }
		return false;
	}

	// Layered images (the eyes' iris + sclera) are composited by Daz Studio into its temp folder and
	// overwritten by the next scene: copy them next to the scene.
	function keepMap(path, outDir) {
		if (path.indexOf("/temp/") < 0) return path;
		var dst = outDir + "map_" + path.split("/").pop().replace(/ /g, "_");
		var f = new DzFile(path);
		if (new DzFile(dst).exists()) new DzFile(dst).remove();
		f.copy(dst);
		return dst;
	}

	function materials(outDir) {
		var out = {}, figs = figures();
		for (var i = 0; i < figs.length; i++) {
			var node = figs[i], shape = node.getObject().getCurrentShape(), mats = shape.getAllMaterials(), M = {};
			for (var k = 0; k < mats.length; k++) {
				var m = mats[k], P = {};
				for (var q = 0; q < m.getNumProperties(); q++) {
					var p = m.getProperty(q), e = {}, keep = false;
					if (p.inherits("DzFloatColorProperty") || p.inherits("DzColorProperty")) {
						var c = p.getColorValue(); e.v = [num(c.red / 255), num(c.green / 255), num(c.blue / 255)]; keep = true;
					} else if (p.inherits("DzNumericProperty")) { e.v = num(p.getValue()); keep = true; }
					if (p.inherits("DzImageProperty") || p.isMappable && p.isMappable()) {
						var t = p.getMapValue();
						if (t) { e.map = keepMap(t.getFilename(), outDir); keep = true; }
					}
					if (keep) P[p.getName()] = e;
				}
				M[m.getName()] = P;
			}
			out[node.getName()] = { label: node.getLabel(), vertices: node.getObject().getCachedGeom().getNumVertices(), materials: M };
		}
		return JSON.stringify(out, null, 1);
	}

	function bones() {
		var out = {}, figs = figures();
		for (var i = 0; i < figs.length; i++) {
			if (figs[i].getName() !== "Genesis9") continue;
			var bs = figs[i].getAllBones();
			for (var k = 0; k < bs.length; k++) {
				var b = bs[k], o = b.getWSPos(), e = b.getEndPoint();
				out[b.getName()] = { o: [num(o.x), num(o.y), num(o.z)], e: [num(e.x), num(e.y), num(e.z)] };
			}
		}
		return JSON.stringify(out);
	}

	for (var j = 0; j < spec.jobs.length; j++) {
		var job = spec.jobs[j];
		try {
			Scene.clear();
			App.getContentMgr().openFile(lib + "People/Genesis 9/Genesis 9.duf", true);
			var g9 = null, figs = figures();
			for (var i = 0; i < figs.length; i++) if (figs[i].getName() === "Genesis9") g9 = figs[i];
			// a preset is a library path (applied with Genesis 9 selected) or [path, node name part]
			// (applied to that node, e.g. a hair's material preset)
			for (var p = 0; p < job.presets.length; p++) {
				var pr = job.presets[p], path = typeof pr === "string" ? pr : pr[0], target = g9;
				if (typeof pr !== "string") {
					target = null; figs = figures();
					for (var i = 0; i < figs.length; i++) if (figs[i].getName().indexOf(pr[1]) >= 0 || figs[i].getLabel().indexOf(pr[1]) >= 0) target = figs[i];
					if (!target) { log.push("job " + j + ": no node " + pr[1] + " for " + path); continue; }
				}
				Scene.selectAllNodes(false);
				Scene.setPrimarySelection(target);
				if (!App.getContentMgr().openFile(lib + path, true)) log.push("job " + j + ": preset failed " + path);
			}
			// nodes a preset brought that are not wanted (e.g. the Pixie hair's strands: only its
			// fitted scalp cap is kept, as the base of the app's own competition hair)
			var drop = job.remove || [];
			figs = figures();
			for (var i = 0; i < figs.length; i++)
				for (var r = 0; r < drop.length; r++)
					if (figs[i].getName().indexOf(drop[r]) >= 0 || figs[i].getLabel().indexOf(drop[r]) >= 0) { Scene.removeNode(figs[i]); break; }
			var names = Object.keys(job.morphs || {});
			for (var k = 0; k < names.length; k++) if (!setModifier(g9, names[k], job.morphs[names[k]])) log.push("job " + j + ": no modifier " + names[k]);
			// base resolution: the cage, posed (the Python side subdivides it)
			figs = figures();
			for (var i = 0; i < figs.length; i++) {
				var lod = figs[i].getObject().getCurrentShape().findProperty("lodlevel");
				if (lod) lod.setValue(0);
			}
			Scene.selectAllNodes(false);
			var exp = App.getExportMgr().findExporterByClassName("DzObjExporter"), s = new DzFileIOSettings();
			exp.getDefaultOptions(s);
			s.setStringValue("Preset", "Custom");
			s.setFloatValue("Scale", 1);
			s.setBoolValue("WriteVN", false); s.setBoolValue("WriteVT", true);
			s.setBoolValue("WriteG", true); s.setBoolValue("GroupGeom", false); s.setBoolValue("GroupNodes", true); s.setBoolValue("GroupSurfaces", true);
			s.setBoolValue("WriteUsemtl", true); s.setBoolValue("WriteMtllib", true);
			s.setBoolValue("SelectedOnly", false); s.setBoolValue("SelectedRootsOnly", false); s.setBoolValue("IncludeParented", true);
			s.setBoolValue("RemoveUnusedVerts", false); s.setBoolValue("WeldSeams", false); s.setBoolValue("CollapseUVTiles", false);
			s.setIntValue("RunSilent", 1);
			exp.writeFile(job.out + "scene.obj", s);
			write(job.out + "materials.json", materials(job.out));
			write(job.out + "bones.json", bones());
			log.push("job " + j + ": ok " + job.out);
		} catch (e) { log.push("job " + j + ": ERROR " + e); }
	}
	}
})();
